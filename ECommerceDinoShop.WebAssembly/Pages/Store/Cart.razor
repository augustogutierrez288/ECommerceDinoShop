@page "/cart"

@using ECommerceDinoShop.DTO
@using ECommerceDinoShop.DTO.Shipping
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.JSInterop 
@using System.Text.Json
@inject IOrderService _orderService
@inject IShippingService _shippingService
@inject ICartService _cartService
@inject IToastService _toastService
@inject NavigationManager _navServicio
@inject HttpClient _http
@inject IJSRuntime _js

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Mi Carrito</h5>
                </div>
                <div class="card-body">
                    @if (list != null && list.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Precio</th>
                                        <th>Cantidad</th>
                                        <th>Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in list)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 50px; height: 50px; object-fit: cover;" class="me-2 rounded" />
                                                    <span>@item.Product.Name</span>
                                                </div>
                                            </td>
                                            <td>$@item.Price</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <button class="btn btn-sm btn-outline-secondary px-2" @onclick="() => Decrease(item.Product.IdProduct)">-</button>
                                                    <span class="mx-2">@item.Quantity</span>
                                                    <button class="btn btn-sm btn-outline-secondary px-2" @onclick="() => Increase(item.Product.IdProduct)">+</button>
                                                </div>
                                            </td>
                                            <td>$@(item.Price* item.Quantity)</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(item.Product.IdProduct)">
                                                    <i class="oi oi-trash"></i> Quitar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            Tu carrito está vacío. <a href="/catalog">¡Sigue comprando!</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="oi oi-location"></i> Opciones de Envío</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-8">
                            <input type="text" class="form-control" placeholder="Ingresa tu Código Postal" @bind="shippingData.ZipCode" />
                        </div>
                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100" @onclick="CalculateShipping" disabled="@string.IsNullOrWhiteSpace(shippingData.ZipCode)">Cotizar</button>
                        </div>
                    </div>

                    @if (isCalculatingShipping)
                    {
                        <div class="text-center text-primary my-2">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Calculando...
                        </div>
                    }

                    @if (shippingOptions != null && shippingOptions.Any())
                    {
                        <div class="mb-2">
                            <label class="form-label fw-bold">Selecciona una opción de Correo Argentino:</label>
                            <select class="form-select" @onchange="OnShippingOptionSelected">
                                <option value="0">Seleccione un método de envío...</option>
                                @foreach (var option in shippingOptions)
                                {
                                    <option value="@option.Price">@option.Name = $@option.Price</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="oi oi-home"></i> Dirección de Entrega</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-8 mb-2">
                            <label class="form-label small mb-1">Calle</label>
                            <input type="text" class="form-control form-control-sm" @bind="shippingData.Street" placeholder="Ej: Av. San Martín" />
                        </div>
                        <div class="col-4 mb-2">
                            <label class="form-label small mb-1">Número</label>
                            <input type="text" class="form-control form-control-sm" @bind="shippingData.Number" placeholder="Ej: 1234" />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label small mb-1">Piso / Depto</label>
                            <input type="text" class="form-control form-control-sm" @bind="shippingData.Apartment" placeholder="Ej: 3 B" />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label small mb-1">Localidad/Provincia</label>
                            <input type="text" class="form-control form-control-sm" @bind="shippingData.City" placeholder="Ej: San Miguel de Tucumán" />
                        </div>
                        <div class="col-12 mb-2">
                            <label class="form-label small mb-1">Referencias de entrega</label>
                            <textarea class="form-control form-control-sm" @bind="shippingData.Reference" rows="2" placeholder="Ej: Entre calles, color del portón, dejar en recepción..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h5 class="card-title border-bottom pb-2 mb-3">Resumen de Compra</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal de productos:</span>
                        <span>$@list.Sum(i => i.Total )</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Costo de envío:</span>
                        <span>$@selectedShippingCost</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <h4 class="fw-bold mb-0">Total:</h4>
                        <h4 class="fw-bold text-success mb-0">$@(list.Sum(i => i.Total ) + selectedShippingCost)</h4>
                    </div>

                    <AuthorizeView>
                        <Authorized>
                            <button class="btn btn-primary w-100 btn-lg shadow-sm"
                                    @onclick="ProcessPaymentWithMercadoPago"
                                    disabled="@(list == null || !list.Any() || selectedShippingCost == 0 || string.IsNullOrWhiteSpace(shippingData.Street))">
                                Pagar con Mercado Pago <img src="images/mercadopago.png" alt="MP" style="height: 20px; margin-left: 5px;" />
                            </button>

                            @if (selectedShippingCost == 0 || string.IsNullOrWhiteSpace(shippingData.Street))
                            {
                                <div class="text-danger small text-center mt-2">
                                    Debes cotizar, elegir un envío y completar tu dirección (Calle) para continuar.
                                </div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <div class="alert alert-info text-center">
                                Debes <a href="/login">iniciar sesión</a> para realizar tu compra.
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>

                </div>
            </div>

        </div>
    </div>
</div>


@code {
    private bool disabled = true;
    private bool isProcessing = false;
    private List<CartDTO> list = new List<CartDTO>();
    private CardDTO card = new CardDTO();

    // Variables para el carrito
    private decimal cartTotal = 0; // Asigna aquí el total de los productos de tu carrito
    private decimal selectedShippingCost = 0;
    private List<ShippingOptionDTO> shippingOptions = new(); // Reemplaza con tu DTO de opciones
    private bool isCalculatingShipping = false;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private SendPaymentDTO paymentModel = new SendPaymentDTO
    {
        PhoneAreaCode = string.Empty,
        PhoneNumber = string.Empty,
        IdentificationNumber = string.Empty,
        ZipCode = string.Empty,
        StreetName = string.Empty,
        StreetNumber = string.Empty,
        Items = new List<CartItemShortDTO>()
    };


    protected override async Task OnInitializedAsync()
    {
        list = await _cartService.ReturnCart();

        var authState = await AuthenticationState;
        if (authState.User.Identity.IsAuthenticated)
            disabled = false;

    }

    private void Decrease(int id)
    {
        CartDTO item = list.First(p => p.Product.IdProduct == id);
        decimal? finalPrice = (item.Product.SalePrice != 0 && item.Product.SalePrice < item.Product.Price) ? item.Product.SalePrice : item.Product.Price;
        if (item.Quantity - 1 > 0)
        {
            item.Quantity--;
            item.Total = item.Quantity * finalPrice;
        }
    }

    private void Increase(int id)
    {
        CartDTO item = list.First(p => p.Product.IdProduct == id);
        decimal? finalPrice = (item.Product.SalePrice != 0 && item.Product.SalePrice < item.Product.Price) ? item.Product.SalePrice : item.Product.Price;
        item.Quantity++;
        item.Total = item.Quantity * finalPrice;
    }

    private async Task Delete(int idProduct)
    {
        CartDTO product = list.First(p => p.Product.IdProduct == idProduct);
        if (product != null)
        {
            list.Remove(product);
            await _cartService.DeleteCart(idProduct);
        }
    }

    // Modelo de datos para capturar la dirección
    private ShippingAddressData shippingData = new ShippingAddressData();

    // Método que reutiliza la lógica de Detail.razor
    private async Task CalculateShipping()
    {
        isCalculatingShipping = true; // Indica que está calculando
        try
        {
            var response = await _shippingService.QuoteShipping(shippingData.ZipCode);
            shippingOptions = response?.Result ?? new List<ShippingOptionDTO>();
        }
        finally
        {
            isCalculatingShipping = false; // Finaliza el cálculo
        }
    }

    private void OnShippingOptionSelected(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value.ToString(), out decimal cost))
        {
            selectedShippingCost = cost;
        }
    }

    // LÓGICA CORE INTEGRADA
    private async Task ProcessPaymentWithMercadoPago()
    {
        // 1. Obtener la lista de órdenes para calcular el próximo ID
        var ordersResponse = await _orderService.List();
        int lastOrderId = 0;

        if (ordersResponse.Result != null && ordersResponse.Result.Any())
        {
            lastOrderId = ordersResponse.Result.Max(o => o.IdOrder);
        }

        int nextOrderId = lastOrderId + 1;

        // 2. Preparar el registro para el LocalStorage
        shippingData.OrderId = nextOrderId;
        shippingData.ShippingCost = selectedShippingCost;

        // 3. Traer el array actual de localStorage (si existe) y actualizarlo
        var existingDataJson = await _js.InvokeAsync<string>("localStorage.getItem", "demoShippingData");

        var savedShippings = string.IsNullOrEmpty(existingDataJson)
            ? new List<ShippingAddressData>()
            : JsonSerializer.Deserialize<List<ShippingAddressData>>(existingDataJson);

        savedShippings.Add(shippingData);

        // Guardar el array actualizado en localStorage
        await _js.InvokeVoidAsync("localStorage.setItem", "demoShippingData", JsonSerializer.Serialize(savedShippings));




        if(list.Count == 0)
        {
            _toastService.ShowWarning("No se encontraron productos");
            return;
        }

        isProcessing = true;

        try 
        {
            // 1. Obtener ID del Usuario Logueado

            var authState = await AuthenticationState;
            string idUser = authState.User.Claims.Where(c => c.Type == ClaimTypes.NameIdentifier).Select(c => c.Value).Single();

            if (string.IsNullOrEmpty(idUser))
            {
                _toastService.ShowError("Error de autenticación.");
                return;
            }

            paymentModel.IdUser = idUser;
   
            paymentModel.ShippingCost = selectedShippingCost;

            // 2. Mapeo Seguro: CartDTO -> CartItemShortDTO
            // Convertimos la lista visual a la lista que necesita el DTO de pago
            paymentModel.Items = list.Select(x => new CartItemShortDTO 
            { 
                ProductId = x.Product.IdProduct, 
                // Usamos GetValueOrDefault porque tu Quantity es nullable int?
                Quantity = x.Quantity.GetValueOrDefault(1) 
            }).ToList();

            // 3. Llamada al Backend (PaymentController)
            // El backend CREARÁ la orden en DB con estado Pendiente y devolverá la PreferenciaID de MP
            var response = await _http.PostAsJsonAsync("Payment/create-preference", paymentModel);
            var result = await response.Content.ReadFromJsonAsync<ResponseDTO<string>>();

            if (result != null && result.IsCorrect)
            {
                var preferenceId = result.Result;
                var publicKey = "APP_USR-e15d81d4-8ab8-4dfe-8345-ad4127d6a519"; // Reemplaza con tu credencial real del Dashboard de MP

                // 4. Iniciar Checkout Pro de Mercado Pago (Modal/Redirect)
                await _js.InvokeVoidAsync("mercadoPagoCheckout", publicKey, preferenceId);
             
            }
            else
            {
                _toastService.ShowError(result?.Message ?? "Error al conectar con Mercado Pago");
            }
        }
        catch (Exception ex)
        {
            _toastService.ShowError("Error inesperado: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class ShippingAddressData
    {
        public int OrderId { get; set; }
        public string ZipCode { get; set; }
        public string Street { get; set; }
        public string Number { get; set; }
        public string Apartment { get; set; }
        public string Reference { get; set; }
        public string City { get; set; }
        public decimal ShippingCost { get; set; }
    }
}