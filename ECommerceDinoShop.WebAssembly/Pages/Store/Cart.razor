@page "/cart"

@using ECommerceDinoShop.DTO
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.JSInterop 

@inject ICartService _cartService
@inject IToastService _toastService
@inject NavigationManager _navServicio
@inject HttpClient _http
@inject IJSRuntime _js

<div class="row mt-4">

    @* INFORMACION DE LOS PRODUCTOS (IZQUIERDA) - MANTENIDA IGUAL *@
    <div class="col-sm-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm bg-light table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:102px"></th>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (list.Any())
                            {
                                foreach (var item in list)
                                {
                                    <tr>
                                        <td valign="middle">
                                            <img class="card-img-top" src="@item.Product.ImageUrl" style="width:100px">
                                        </td>
                                        <td valign="middle">@item.Product.Name</td>
                                        <td valign="middle">@item.Product.Price</td>
                                        <td valign="middle" align="center">
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-outline-danger" @onclick="(() =>Decrease(item.Product.IdProduct))">
                                                    -
                                                </button>
                                                <input class="form-control" readonly="readonly" style="width:50px" value="@item.Quantity" />
                                                <button type="button" class="btn btn-success" @onclick="(() =>Increase(item.Product.IdProduct))">
                                                    +
                                                </button>
                                            </div>
                                        </td>
                                        <td valign="middle">@item.Total</td>
                                        <td valign="middle">
                                            <button type="button" class="btn btn-danger" @onclick="(async () => await Delete(item.Product.IdProduct))">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                    <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="alert alert-warning" role="alert">
                                            No hay productos en el carrito
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* FORMULARIO DE PAGO MERCADO PAGO (DERECHA) - ACTUALIZADO *@
    <div class="col-sm-4">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Datos de Facturación</h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="paymentModel" OnValidSubmit="ProcessPaymentWithMercadoPago">
                    <DataAnnotationsValidator />

                    @* SECCIÓN 1: IDENTIDAD *@
                    <h6 class="text-secondary border-bottom pb-2 mb-3">
                        <i class="bi bi-person-badge me-2"></i>Datos Personales
                    </h6>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Nombre</label>
                            <InputText class="form-control" placeholder="Ej: Juan" @bind-Value="paymentModel.Name" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.Name)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Apellido</label>
                            <InputText class="form-control" placeholder="Ej: Pérez" @bind-Value="paymentModel.Surname" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.Surname)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <InputText class="form-control" placeholder="juan@mail.com" @bind-Value="paymentModel.Email" disabled="@disabled" />
                        </div>
                        <ValidationMessage For="@(() => paymentModel.Email)" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small text-muted">Tipo Doc.</label>
                            <InputSelect class="form-select" @bind-Value="paymentModel.IdentificationType" disabled="@disabled">
                                <option value="DNI">DNI</option>
                                <option value="CUIL">CUIL</option>
                                <option value="CUIT">CUIT</option>
                            </InputSelect>
                        </div>
                        <div class="col-8">
                            <label class="form-label small text-muted">Número Doc.</label>
                            <InputText class="form-control" placeholder="Sin puntos" @bind-Value="paymentModel.IdentificationNumber" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.IdentificationNumber)" />
                        </div>
                    </div>

                    @* SECCIÓN 2: CONTACTO *@
                    <h6 class="text-secondary border-bottom pb-2 mb-3 mt-4">
                        <i class="bi bi-telephone me-2"></i>Teléfono
                    </h6>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small text-muted">Cód. Área</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted">0</span>
                                <InputText class="form-control" placeholder="381" @bind-Value="paymentModel.PhoneAreaCode" disabled="@disabled" />
                            </div>
                            <ValidationMessage For="@(() => paymentModel.PhoneAreaCode)" />
                        </div>
                        <div class="col-8">
                            <label class="form-label small text-muted">Número</label>
                            <InputText class="form-control" placeholder="155977039" @bind-Value="paymentModel.PhoneNumber" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.PhoneNumber)" />
                        </div>
                    </div>

                    @* SECCIÓN 3: UBICACIÓN *@
                    <h6 class="text-secondary border-bottom pb-2 mb-3 mt-4">
                        <i class="bi bi-geo-alt me-2"></i>Domicilio de Envío
                    </h6>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small text-muted">Calle</label>
                            <InputText class="form-control" placeholder="Ej: Av. Roca" @bind-Value="paymentModel.StreetName" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.StreetName)" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Altura</label>
                            <InputText class="form-control" placeholder="123" @bind-Value="paymentModel.StreetNumber" disabled="@disabled" />
                            <ValidationMessage For="@(() => paymentModel.StreetNumber)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Código Postal</label>
                        <InputText class="form-control" placeholder="Ej: 4000" @bind-Value="paymentModel.ZipCode" disabled="@disabled" />
                        <ValidationMessage For="@(() => paymentModel.ZipCode)" />
                    </div>

                    @* RESUMEN DE PAGO *@
                    <div class="bg-light p-3 rounded border mt-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Total a Pagar:</span>
                            <span class="fs-5 fw-bold text-success">$ @(list.Sum(i => i.Total))</span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <AuthorizeView>
                            <Authorized Context="authContext">
                                <div class="d-grid gap-2">
                                    @if (isProcessing)
                                    {
                                        <button class="btn btn-secondary py-2" disabled type="button">
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            Procesando pedido...
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary py-2 fw-bold shadow-sm" type="submit" disabled="@(!list.Any())">
                                            <i class="bi bi-wallet2 me-2"></i> Ir a Pagar con Mercado Pago
                                        </button>
                                    }
                                </div>
                            </Authorized>
                            <NotAuthorized Context="authContext">
                                <div class="alert alert-warning d-flex align-items-center mt-2" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div>Inicia sesión para finalizar la compra.</div>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private bool disabled = true;
    private bool isProcessing = false;
    private List<CartDTO> list = new List<CartDTO>();
    private CardDTO card = new CardDTO();

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private SendPaymentDTO paymentModel = new SendPaymentDTO
    {
        PhoneAreaCode = string.Empty,
        PhoneNumber = string.Empty,
        IdentificationNumber = string.Empty,
        ZipCode = string.Empty,
        StreetName = string.Empty,
        StreetNumber = string.Empty,
        Items = new List<CartItemShortDTO>()
    };


    protected override async Task OnInitializedAsync()
    {
        list = await _cartService.ReturnCart();

        var authState = await AuthenticationState;
        if (authState.User.Identity.IsAuthenticated)
            disabled = false;
    }

    private void Decrease(int id)
    {
        CartDTO item = list.First(p => p.Product.IdProduct == id);
        decimal? finalPrice = (item.Product.SalePrice != 0 && item.Product.SalePrice < item.Product.Price) ? item.Product.SalePrice : item.Product.Price;
        if (item.Quantity - 1 > 0)
        {
            item.Quantity--;
            item.Total = item.Quantity * finalPrice;
        }
    }

    private void Increase(int id)
    {
        CartDTO item = list.First(p => p.Product.IdProduct == id);
        decimal? finalPrice = (item.Product.SalePrice != 0 && item.Product.SalePrice < item.Product.Price) ? item.Product.SalePrice : item.Product.Price;
        item.Quantity++;
        item.Total = item.Quantity * finalPrice;
    }

    private async Task Delete(int idProduct)
    {
        CartDTO product = list.First(p => p.Product.IdProduct == idProduct);
        if (product != null)
        {
            list.Remove(product);
            await _cartService.DeleteCart(idProduct);
        }
    }

    // LÓGICA CORE INTEGRADA: Mercado Pago + Orden en Backend
    private async Task ProcessPaymentWithMercadoPago()
    {
        if(list.Count == 0)
        {
            _toastService.ShowWarning("No se encontraron productos");
            return;
        }

        isProcessing = true;

        try 
        {
            // 1. Obtener ID del Usuario Logueado

            var authState = await AuthenticationState;
            string idUser = authState.User.Claims.Where(c => c.Type == ClaimTypes.NameIdentifier).Select(c => c.Value).Single();

            if (string.IsNullOrEmpty(idUser))
            {
                _toastService.ShowError("Error de autenticación.");
                return;
            }

            paymentModel.IdUser = idUser;

            // 2. Mapeo Seguro: CartDTO -> CartItemShortDTO
            // Convertimos la lista visual a la lista que necesita el DTO de pago
            paymentModel.Items = list.Select(x => new CartItemShortDTO 
            { 
                ProductId = x.Product.IdProduct, 
                // Usamos GetValueOrDefault porque tu Quantity es nullable int?
                Quantity = x.Quantity.GetValueOrDefault(1) 
            }).ToList();

            // 3. Llamada al Backend (PaymentController)
            // El backend CREARÁ la orden en DB con estado Pendiente y devolverá la PreferenciaID de MP
            var response = await _http.PostAsJsonAsync("Payment/create-preference", paymentModel);
            var result = await response.Content.ReadFromJsonAsync<ResponseDTO<string>>();

            if (result != null && result.IsCorrect)
            {
                var preferenceId = result.Result;
                var publicKey = "APP_USR-e15d81d4-8ab8-4dfe-8345-ad4127d6a519"; // Reemplaza con tu credencial real del Dashboard de MP

                // 4. Iniciar Checkout Pro de Mercado Pago (Modal/Redirect)
                await _js.InvokeVoidAsync("mercadoPagoCheckout", publicKey, preferenceId);
                
                // Nota: No limpiamos el carrito aquí. Se limpia en la pagina "Success" o "Aprobado" 
                // cuando MP retorna, o mediante el Webhook.
            }
            else
            {
                _toastService.ShowError(result?.Message ?? "Error al conectar con Mercado Pago");
            }
        }
        catch (Exception ex)
        {
            _toastService.ShowError("Error inesperado: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }
}